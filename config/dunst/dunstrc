# green / synthwave dunst
[global]
    monitor = 0
    follow = mouse
    width = 360
    height = (0, 200)
    origin = top-right
    offset = (14, 50)
    scale = 0
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_corner_radius = 4
    progress_bar_min_width = 150
    progress_bar_max_width = 340
    icon_corner_radius = 8

    transparency = 18
    separator_height = 2
    padding = 12
    horizontal_padding = 14
    frame_width = 2
    corner_radius = 14
    gap_size = 6

    font = JetBrainsMono Nerd Font 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    icon_position = left
    min_icon_size = 24
    max_icon_size = 48

    sort = yes
    idle_threshold = 120
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    sticky_history = yes
    history_length = 30

    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

[sound]
    script = __HOME__/.config/hypr/scripts/play-sound.sh notif

[urgency_low]
    background = "#0a0f0b"
    foreground = "#538b60"
    frame_color = "#1b231e"
    timeout = 5

[urgency_normal]
    background = "#0a0f0b"
    foreground = "#d6f3db"
    frame_color = "#47f154"
    timeout = 8

[urgency_critical]
    background = "#0a0f0b"
    foreground = "#d6f3db"
    frame_color = "#f85149"
    timeout = 0
