// PROTO//GREEN fastfetch — neon showcase
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/protogen.txt",
        "type": "file",
        "color": {
            "1": "green",
            "2": "38;2;57;255;106",
            "3": "38;2;144;255;168",
            "4": "38;2;47;230;160",
            "5": "38;2;79;143;104"
        },
        "padding": { "top": 1, "right": 4 }
    },
    "display": {
        "separator": " ",
        "color": { "keys": "38;2;57;255;106", "title": "38;2;144;255;168" },
        "key": { "width": 14 }
    },
    "modules": [
        { "type": "title", "format": "{user-name}@{host-name}" },
        { "type": "custom", "format": "\u001b[38;2;79;143;104m────────────────────────────" },
        { "type": "os",      "key": "  os" },
        { "type": "kernel",  "key": "  kernel" },
        { "type": "wm",      "key": "  wm" },
        { "type": "uptime",  "key": "  uptime" },
        { "type": "packages","key": "󰏖  pkgs" },
        { "type": "terminal","key": "  term" },
        { "type": "cpu",     "key": "  cpu" },
        { "type": "gpu",     "key": "󰢮  gpu" },
        { "type": "memory",  "key": "  mem" },
        { "type": "custom", "format": "\u001b[38;2;79;143;104m────────────────────────────" },
        { "type": "colors", "symbol": "circle" }
    ]
}
