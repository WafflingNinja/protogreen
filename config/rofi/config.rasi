/* refined green rofi — glam icon grid, blurred (blur via hyprland layerrule) */
configuration {
    modes:                      "drun,run,window";
    font:                       "JetBrainsMono Nerd Font 11";
    show-icons:                 true;
    icon-theme:                 "Papirus-Dark";
    display-drun:               " Apps";
    display-run:                " Run";
    display-window:             " Window";
    drun-display-format:        "{name}";
    terminal:                   "kitty";
    hover-select:               true;
    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";
    kb-cancel:                  "Escape,MouseSecondary";
}

* {
    bg:        rgba(10, 15, 11, 0.72);
    bg-alt:    rgba(20, 31, 24, 0.85);
    fg:        #d6f3dbff;
    muted:     #538b60ff;
    accent:    #47f154ff;
    sage:      #98f79cff;
    teal:      #3cd983ff;

    background-color:           transparent;
    text-color:                 @fg;
}

window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    width:                      820px;
    border-radius:              18px;
    background-color:           @bg;
    border:                     2px;
    border-color:               @accent;
    padding:                    8px;
}

mainbox {
    padding:                    16px;
    spacing:                    14px;
    children:                   [ "inputbar", "listview" ];
}

inputbar {
    background-color:           @bg-alt;
    border-radius:              12px;
    border:                     0px 0px 2px 0px;
    border-color:               @teal;
    padding:                    12px 16px;
    spacing:                    10px;
    children:                   [ "prompt", "entry" ];
}

prompt { text-color: @sage; }
entry  { placeholder: "search…"; placeholder-color: @muted; cursor: text; }

/* icon grid */
listview {
    columns:                    5;
    lines:                      3;
    fixed-columns:              true;
    cycle:                      true;
    scrollbar:                  false;
    spacing:                    10px;
}

element {
    orientation:                vertical;
    padding:                    14px 8px;
    border-radius:              14px;
    spacing:                    8px;
    background-color:           rgba(20, 31, 24, 0.55);
    children:                   [ "element-icon", "element-text" ];
}
element normal.normal   { background-color: rgba(20, 31, 24, 0.55); text-color: @fg; }
element alternate.normal { background-color: rgba(20, 31, 24, 0.55); text-color: @fg; }
element normal.active   { background-color: rgba(20, 31, 24, 0.55); text-color: @sage; }
element selected.normal {
    background-color:           @accent;
    text-color:                 #0a0f0bff;
    border:                     1px;
    border-color:               @sage;
}
element selected.active {
    background-color:           @accent;
    text-color:                 #0a0f0bff;
}
element-icon {
    size:                       54px;
    horizontal-align:           0.5;
    background-color:           transparent;
}
element-text {
    horizontal-align:           0.5;
    vertical-align:             0.5;
    text-color:                 inherit;
    background-color:           transparent;
}
