/* compact green power menu */
configuration {
    show-icons: false;
}

* {
    bg:     rgba(10, 15, 11, 0.78);
    bg-alt: rgba(20, 31, 24, 0.85);
    fg:     #d6f3dbff;
    accent: #47f154ff;
    sage:   #98f79cff;
    red:    #f85149ff;
    background-color: transparent;
    text-color: @fg;
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 280px;
    border-radius: 16px;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
}

mainbox {
    padding: 16px;
    spacing: 10px;
    children: [ "inputbar", "listview" ];
}

inputbar {
    background-color: @bg-alt;
    border-radius: 10px;
    padding: 10px 14px;
    children: [ "prompt" ];
}
prompt { text-color: @sage; }

listview {
    columns: 1;
    lines: 5;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 10px 14px;
    border-radius: 10px;
    spacing: 10px;
}
element normal.normal   { text-color: @fg; }
element selected.normal {
    background-color: @accent;
    text-color: #0a0f0bff;
}
